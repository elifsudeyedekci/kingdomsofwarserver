# ─────────────────────────────────────────────────────────────────────────────
#  Kingdoms of War — Admin Backend · Environment Variables
#  Copy this file to .env and fill in real values before starting the server.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://kowuser:kowpassword@localhost:5432/kingdoms_of_war

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Auth / JWT ───────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-with-at-least-64-random-hex-chars
JWT_REFRESH_SECRET=replace-with-a-different-64-random-hex-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:3002

# ── Rate Limiting (Throttler) ─────────────────────────────────────────────────
THROTTLE_TTL=60
THROTTLE_LIMIT=1000

# ── Admin Seed Credentials ───────────────────────────────────────────────────
ADMIN_DEFAULT_EMAIL=admin@kingdoms-of-war.com
ADMIN_DEFAULT_PASSWORD=change-me-immediately

# ── Firebase (Push Notifications) ────────────────────────────────────────────
FIREBASE_PROJECT_ID=kingdoms-of-war-prod
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@kingdoms-of-war-prod.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_ACTUAL_KEY\n-----END PRIVATE KEY-----\n"

# ── AWS (S3 Asset Storage) ────────────────────────────────────────────────────
AWS_REGION=eu-central-1
AWS_S3_BUCKET=kingdoms-of-war-assets
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY

# ── Stripe (Payments) ─────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_replace_with_real_key
STRIPE_WEBHOOK_SECRET=whsec_replace_with_real_secret

# ── Monitoring ────────────────────────────────────────────────────────────────
SENTRY_DSN=https://replace@o0.ingest.sentry.io/0
