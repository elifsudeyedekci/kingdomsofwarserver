# Template. Run ./generate-secrets.sh to get a real .env.production with random secrets. NEVER commit .env.production.
# ---- domains (DNS A records of BOTH must point at the server before `up`) ----
API_DOMAIN=api.example.com
PANEL_DOMAIN=panel.example.com
ACME_EMAIL=you@example.com

# ---- secrets (generated) ----
POSTGRES_PASSWORD=__POSTGRES_PASSWORD__
REDIS_PASSWORD=__REDIS_PASSWORD__
JWT_SECRET=__JWT_SECRET__
JWT_REFRESH_SECRET=__JWT_REFRESH_SECRET__
ADMIN_JWT_SECRET=__ADMIN_JWT_SECRET__
NEXTAUTH_SECRET=__NEXTAUTH_SECRET__
BACKUP_AGENT_TOKEN=__BACKUP_AGENT_TOKEN__

# ---- backend behaviour ----
CORS_ORIGINS=https://panel.example.com
ADMIN_REQUIRE_2FA=true
PAYMENTS_DEV_MODE=false
SWAGGER_ENABLED=false
# Optional: only these IPs may reach the admin API (comma separated). Leave empty to allow everyone (login is still protected).
IP_ALLOWLIST=
BACKUP_KEEP_DAYS=14

# ---- captcha (Cloudflare Turnstile; leave empty = no captcha) ----
TURNSTILE_SECRET=
TURNSTILE_SITE_KEY=

# ---- Google Play purchase validation (empty = real Android purchases are refused) ----
GOOGLE_PLAY_PACKAGE=com.kingdomsofwar.game
# path inside the container is not available (read-only fs): paste the service-account JSON on ONE line
GOOGLE_SERVICE_ACCOUNT_JSON=

# ---- Apple purchase validation (empty = real iOS purchases are refused) ----
APPLE_ISSUER_ID=
APPLE_KEY_ID=
APPLE_BUNDLE_ID=com.kingdomsofwar.game
APPLE_ENV=production
# the .p8 text with literal \n for line breaks
APPLE_PRIVATE_KEY=
