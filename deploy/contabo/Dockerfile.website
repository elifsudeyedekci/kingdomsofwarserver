# Build context = repository root:  docker build -f deploy/contabo/Dockerfile.website .
# The build downloads the Cinzel font from Google Fonts (next/font), so the build machine needs internet access.
FROM node:20-alpine AS build
WORKDIR /site
COPY landing-website/package*.json ./
RUN npm ci
COPY landing-website ./
RUN npm run build

FROM caddy:2-alpine
COPY deploy/contabo/Caddyfile.website /etc/caddy/Caddyfile
COPY --from=build /site/out /srv
EXPOSE 80
